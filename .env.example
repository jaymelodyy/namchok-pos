# คัดลอกเป็น .env.local แล้วใส่ค่าจาก Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...   # public key สำหรับ client
SUPABASE_SERVICE_ROLE_KEY=eyJ...       # ฝั่งเซิร์ฟเวอร์เท่านั้น ; ห้ามขึ้นต้น NEXT_PUBLIC_ และห้ามส่งให้เบราว์เซอร์
